# Copie este arquivo para ".env" (na raiz do projeto) e ajuste por ambiente.
# Sem esse arquivo, o docker-compose usa os valores padrão de desenvolvimento.

# Ambiente: development (dev/testes) ou production (homologação/produção)
NODE_ENV=development

# Banco de dados (MySQL dentro do Docker)
DB_ROOT_PASSWORD=root_mimetic
DB_USER=mimetic
DB_PASSWORD=mimetic123
DB_PORT_HOST=3307

# Segredo dos tokens de login: use um texto longo e aleatório fora do dev
JWT_SECRET=troque_este_segredo_em_producao_mimetic_soft
